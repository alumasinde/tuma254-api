meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "phone": "{{testPhone}}",
    "firstName": "{{testFirstName}}",
    "lastName": "{{testLastName}}",
    "password": "{{testPassword}}"
  }
}

tests {
  test("registration accepted", function() {
    expect(res.status).to.be.oneOf([201, 409]);
  });
}
