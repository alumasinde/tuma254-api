meta {
  name: Old Refresh Token Rejected
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{oldRefreshToken}}"
  }
}

tests {
  test("rotated refresh token is rejected", function() {
    expect(res.status).to.equal(401);
  });
}
