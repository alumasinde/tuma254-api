meta {
  name: Invalid Token
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: invalid.access.token
}

tests {
  test("invalid token returns 401", function() {
    expect(res.status).to.equal(401);
  });

  test("returns authentication error", function() {
    expect(res.body.error).to.equal("invalid access token");
  });
}
