meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

tests {
  test("me returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("me returns database-backed current user", function() {
    expect(res.body.user.id).to.be.a("string");
    expect(res.body.user.first_name).to.be.a("string");
    expect(res.body.user.last_name).to.be.a("string");
    expect(res.body.user.status).to.equal("active");
    expect(res.body.user.roles).to.be.an("array");
  });
}
