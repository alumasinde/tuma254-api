meta {
  name: Missing Token
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/api/v1/auth/me
  body: none
  auth: none
}

tests {
  test("missing token returns 401", function() {
    expect(res.status).to.equal(401);
  });

  test("returns authentication error", function() {
    expect(res.body.error).to.be.a("string");
  });
}
