meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/auth/register
  body: json
  auth: none
}

script:pre-request {
  const timestamp = Date.now();
  bru.setVar("TEST_EMAIL", `test.user.${timestamp}@example.com`);
  bru.setVar("TEST_PASSWORD", "StrongPass123!");
}

body:json {
  {
    "first_name": "Test",
    "last_name": "User",
    "email": "{{TEST_EMAIL}}",
    "phone": "",
    "password": "{{TEST_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.user && res.body.tokens) {
    bru.setVar("USER_ID", res.body.user.id);
    bru.setVar("ACCESS_TOKEN", res.body.tokens.access_token);
    bru.setVar("REFRESH_TOKEN", res.body.tokens.refresh_token);
  }
}

tests {
  test("register returns 201", function() {
    expect(res.status).to.equal(201);
  });

  test("returns normalized user data", function() {
    expect(res.body.user).to.have.property("id");
    expect(res.body.user).to.have.property("first_name");
    expect(res.body.user).to.have.property("last_name");
    expect(res.body.user.status).to.equal("active");
    expect(res.body.user.roles).to.include("customer");
  });

  test("returns token pair", function() {
    expect(res.body.tokens.access_token).to.be.a("string");
    expect(res.body.tokens.refresh_token).to.be.a("string");
  });
}
