APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
DATABASE_URL=postgres://tuma254:tuma254@localhost:5432/tuma254?sslmode=disable
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
OTP_HASH_SECRET=use-a-different-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
OTP_TTL=10m
OTP_RESEND_COOLDOWN=60s
OTP_RESEND_WINDOW=1h
OTP_MAX_RESENDS=5
OTP_MAX_ATTEMPTS=5