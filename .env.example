APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Docker PostgreSQL credentials. Choose your own password in your local .env.
POSTGRES_DB=tuma254
POSTGRES_USER=alumasinde
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://alumasinde:change-this-local-password@127.0.0.1:5433/tuma254?sslmode=disable

JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
OTP_HASH_SECRET=use-a-different-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

OTP_TTL=10m
OTP_RESEND_COOLDOWN=60s
OTP_RESEND_WINDOW=1h
OTP_MAX_RESENDS=5
OTP_MAX_ATTEMPTS=5

# Single-process development limiter. Replace with Redis/shared storage when scaling horizontally.
LOGIN_ATTEMPT_WINDOW=15m
LOGIN_MAX_ATTEMPTS=10

SMS_PROVIDER=log
# For production use SMS_PROVIDER=webhook and configure a trusted internal SMS gateway.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
